{
    "name": "songnguxyz/oauth-mediawiki",
    "description": "Log in to your Flarum forum with MediaWiki OAuth2",
    "keywords": [
        "flarum", "mediawiki", "sso", "oauth", "login", "oauth2"
    ],
    "type": "flarum-extension",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/songnguxyz/flarum-ext-oauth-mediawiki/issues",
        "source": "https://github.com/songnguxyz/flarum-ext-oauth-mediawiki"
    },
    "require": {
        "flarum/core": "^1.2.0",
        "fof/oauth": "^1.3.0",
        "league/oauth2-client": "^2.6"
    },
    "authors": [
        {
            "name": "songnguxyz",
            "homepage": "https://github.com/songnguxyz"
        }
    ],
    "autoload": {
        "psr-4": {
            "Songnguxyz\\OAuthMediaWiki\\": "src/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "Log In With MediaWiki",
            "category": "feature",
            "icon": {
                "name": "fab fa-wikipedia-w",
                "backgroundColor": "#006699",
                "color": "#fff"
            }
        }
    }
}
